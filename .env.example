# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/srdiotest

# Server
PORT=3000
CLIENT_URL=http://localhost:4200
JWT_SECRET=change-me-to-a-long-random-string

# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the Authorization callback URL on the OAuth App:
# http://localhost:3000/auth/github/callback

# GitHub webhook secret (set the same value when creating the repo webhook)
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret

# Optional: OpenAI for Copilot bonus (leave empty to use rule-based parse)
OPENAI_API_KEY=
